<Window x:Class="NightGuard.AppAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用已被限制"
        Height="245"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="应用已被限制" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1"
               x:Name="MessageText"
               TextWrapping="Wrap"
               Margin="0,12,0,18"/>

    <StackPanel Grid.Row="2">
      <Button Content="允许使用 1 分钟" Height="32" Margin="0,0,0,8" Click="AllowOneMinute_Click"/>
      <Button Content="允许使用 15 分钟" Height="32" Margin="0,0,0,8" Click="AllowFifteenMinutes_Click"/>
      <Button Content="今晚不限此应用" Height="32" Margin="0,0,0,8" Click="AllowTonight_Click"/>
      <Button Content="继续禁用" Height="32" Click="Deny_Click"/>
    </StackPanel>
  </Grid>
</Window>
