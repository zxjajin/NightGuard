<Window x:Class="NightGuard.AppAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard 提示"
        Height="280"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1"
               x:Name="MessageText"
               TextWrapping="Wrap"
               Margin="0,12,0,18"/>

    <StackPanel Grid.Row="2">
      <Button x:Name="PrimaryButton" Height="32" Margin="0,0,0,8" Click="Primary_Click"/>
      <Button x:Name="SecondaryButton" Height="32" Margin="0,0,0,8" Click="Secondary_Click"/>
      <Button x:Name="TertiaryButton" Height="32" Margin="0,0,0,8" Click="Tertiary_Click"/>
      <Button x:Name="CloseButtonAction" Height="32" Click="CloseButtonAction_Click"/>
    </StackPanel>
  </Grid>
</Window>
