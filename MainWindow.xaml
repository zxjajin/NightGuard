<Window x:Class="NightGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard" Height="700" Width="780"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Grid Margin="16">
    <TabControl>
      <TabItem Header="首页">
        <StackPanel Margin="12" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="NightGuard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <TextBlock Text="{Binding Engine.StatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding Engine.RemainingRestrictionDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.TonightUnlockCountDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.UnlockCountdownDisplay}" Margin="0,0,0,18"/>
          <Button Content="全局临时解锁" Width="140" Height="34" HorizontalAlignment="Left" IsEnabled="{Binding Engine.CanRequestTemporaryUnlock}" Click="TemporaryUnlock_Click"/>
          <TextBlock Text="限制期间打开非白名单应用时，会弹出单独授权窗口，可选择允许 1 分钟、15 分钟或今晚不限。"
                     TextWrapping="Wrap"
                     Margin="0,14,0,0"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <PasswordBox x:Name="SettingsPasswordBox" Width="220" Height="28" Margin="0,0,8,0"/>
              <Button Content="解锁设置" Width="100" Click="UnlockSettings_Click"/>
            </StackPanel>

            <TextBlock Text="限制开始时间（HH:mm）"/>
            <TextBox Text="{Binding EditableConfig.RestrictionStart, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="限制结束时间（HH:mm）"/>
            <TextBox Text="{Binding EditableConfig.RestrictionEnd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <CheckBox Content="限制期间禁用所有非白名单应用"
                      IsChecked="{Binding EditableConfig.BlockAllAppsDuringRestriction}"
                      IsEnabled="{Binding SettingsEditingEnabled}"
                      Margin="0,4,0,10"/>

            <TextBlock Text="始终允许应用（每行一个 exe，例如 explorer.exe）"/>
            <TextBox Text="{Binding AllowedProcessText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="95"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="额外应用黑名单（关闭“禁用所有非白名单应用”时使用）"/>
            <TextBox Text="{Binding ProcessText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="75"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="网站黑名单（每行一个域名，不要写 https://）"/>
            <TextBox Text="{Binding DomainText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="90"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="全局延迟解锁分钟数"/>
            <TextBox Text="{Binding EditableConfig.UnlockDelayMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="全局临时放行分钟数"/>
            <TextBox Text="{Binding EditableConfig.TemporaryAllowanceMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="每晚最大全局解锁次数"/>
            <TextBox Text="{Binding EditableConfig.MaxUnlocksPerNight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <CheckBox Content="开机自启" IsChecked="{Binding EditableConfig.StartWithWindows}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,14"/>

            <TextBlock Text="新设置密码（留空表示不修改）"/>
            <PasswordBox x:Name="NewPasswordBox" Width="220" Height="28" IsEnabled="{Binding SettingsEditingEnabled}" HorizontalAlignment="Left" Margin="0,4,0,16"/>

            <Button Content="保存设置" Width="110" Height="32" IsEnabled="{Binding SettingsEditingEnabled}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
