<Window x:Class="NightGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard"
        Height="760"
        Width="800"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Grid Margin="16">
    <TabControl>
      <TabItem Header="首页">
        <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
          <TextBlock Text="NightGuard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <TextBlock Text="{Binding Engine.StatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding Engine.RemainingRestrictionDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.TonightUnlockCountDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.UnlockCountdownDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.RuleSummaryDisplay}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Engine.StatusNote}" TextWrapping="Wrap" Margin="0,0,0,18"/>

          <Border BorderBrush="#D0D7DE" BorderThickness="1" Padding="10" Margin="0,0,0,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="启动自检" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <Button Content="重新检测" Width="86" Height="28" HorizontalAlignment="Right" Click="RunStartupCheck_Click"/>
              </DockPanel>
              <TextBlock Text="{Binding StartupCheck.CheckedAtText}" Margin="0,0,0,6"/>
              <UniformGrid Columns="2">
                <TextBlock Text="{Binding StartupCheck.Administrator.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StartupCheck.Administrator.StatusText}"/>
                <TextBlock Text="{Binding StartupCheck.HostsWritable.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StartupCheck.HostsWritable.StatusText}"/>
                <TextBlock Text="{Binding StartupCheck.StartupTask.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StartupCheck.StartupTask.StatusText}"/>
                <TextBlock Text="{Binding StartupCheck.RestrictionActive.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StartupCheck.RestrictionActive.StatusText}"/>
              </UniformGrid>
              <TextBlock Text="{Binding StartupCheck.HostsWritable.Suggestion}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button Content="全局临时解锁"
                    Width="130"
                    Height="34"
                    Margin="0,0,10,0"
                    IsEnabled="{Binding Engine.CanRequestTemporaryUnlock}"
                    Click="TemporaryUnlock_Click"/>
            <Button Content="安全测试模式"
                    Width="130"
                    Height="34"
                    Click="StartTestMode_Click"/>
          </StackPanel>

          <TextBlock Text="安全测试模式只会尝试拦截 NightGuardTestApp.exe，不会修改 hosts，也不会影响其它应用。"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0"/>

          <TextBlock Text="23:00 - 23:30 只提醒 Codex / Cursor / AI 网站收尾；23:30 - 07:00 可选择本晚不再限制、记录到明天并最小化，或 15 分钟后再提醒。"
                     TextWrapping="Wrap"
                     Margin="0,14,0,0"/>

          <TextBlock Text="最近拦截记录" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
          <DataGrid ItemsSource="{Binding RecentRecords}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    Height="260"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="70"/>
              <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="110"/>
              <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150"/>
              <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="110"/>
              <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="70"/>
              <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </TabItem>

      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <PasswordBox x:Name="SettingsPasswordBox" Width="220" Height="28" Margin="0,0,8,0"/>
              <Button Content="解锁设置" Width="100" Click="UnlockSettings_Click"/>
            </StackPanel>

            <TextBlock Text="限制开始时间（HH:mm）"/>
            <TextBox Text="{Binding EditableConfig.RestrictionStart, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="限制结束时间（HH:mm）"/>
            <TextBox Text="{Binding EditableConfig.RestrictionEnd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <CheckBox Content="限制期间禁用非白名单前台应用"
                      IsChecked="{Binding EditableConfig.BlockAllAppsDuringRestriction}"
                      IsEnabled="{Binding SettingsEditingEnabled}"
                      Margin="0,4,0,10"/>

            <CheckBox Content="启用网站 hosts 限制（可能影响 Clash/TUN，默认关闭）"
                      IsChecked="{Binding EditableConfig.EnableHostsBlocking}"
                      IsEnabled="{Binding SettingsEditingEnabled}"
                      Margin="0,4,0,10"/>

            <TextBlock Text="始终允许应用（每行一个 exe，例如 explorer.exe）"/>
            <TextBox Text="{Binding AllowedProcessText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="105"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="额外应用黑名单（即使关闭前台应用限制，也会限制这些进程）"/>
            <TextBox Text="{Binding ProcessText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="75"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="网站黑名单（每行一个域名，不要写 https://）"/>
            <TextBox Text="{Binding DomainText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="100"
                     IsEnabled="{Binding SettingsEditingEnabled}"
                     Margin="0,4,0,10"/>

            <TextBlock Text="娱乐规则模板" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ItemsControl ItemsSource="{Binding RuleTemplates}" Margin="0,0,0,12">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Name}"
                          Tag="{Binding}"
                          Width="86"
                          Height="30"
                          Margin="0,0,8,8"
                          IsEnabled="{Binding DataContext.SettingsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                          Click="ApplyTemplate_Click"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="立即恢复 hosts"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,14"
                    Click="RestoreHosts_Click"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="导出配置" Width="100" Height="30" Margin="0,0,8,0" Click="ExportConfig_Click"/>
              <Button Content="导入配置" Width="100" Height="30" Click="ImportConfig_Click"/>
            </StackPanel>

            <TextBlock Text="全局延迟解锁分钟数"/>
            <TextBox Text="{Binding EditableConfig.UnlockDelayMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="全局临时放行分钟数"/>
            <TextBox Text="{Binding EditableConfig.TemporaryAllowanceMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <TextBlock Text="每晚最大全局解锁次数"/>
            <TextBox Text="{Binding EditableConfig.MaxUnlocksPerNight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,10"/>

            <CheckBox Content="开机自启" IsChecked="{Binding EditableConfig.StartWithWindows}" IsEnabled="{Binding SettingsEditingEnabled}" Margin="0,4,0,14"/>

            <TextBlock Text="新设置密码（留空表示不修改）"/>
            <PasswordBox x:Name="NewPasswordBox" Width="220" Height="28" IsEnabled="{Binding SettingsEditingEnabled}" HorizontalAlignment="Left" Margin="0,4,0,16"/>

            <Button Content="保存设置" Width="110" Height="32" IsEnabled="{Binding SettingsEditingEnabled}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
